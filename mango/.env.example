HOST=127.0.0.1
PORT=4311
SQLITE_PATH=mango.sqlite
NODE_ENV=development
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Required in production; keep stable across restarts and secret.
GATEWAY_STATE_KEY=
# Exact origins, comma separated. Required for production. Never wildcard.
CORS_ORIGINS=http://localhost:5173
DEBUG_CONTENT=false
# Default model is mock-scripted, offline. Optional admin registry and script:
# MODELS_FILE=fixtures/models.example.json
# MOCK_SCRIPT_FILE=fixtures/increment-script.json
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional administrator-only endpoint overrides. Production HTTPS required.
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Paid live smoke tests require explicit opt-in AND a configured exact model ID.
LIVE_SMOKE=false
OPENAI_SMOKE_MODEL=
ANTHROPIC_SMOKE_MODEL=
GEMINI_SMOKE_MODEL=
