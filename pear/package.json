{
  "name": "@orchard/pear",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --import tsx src/server/start.ts --dev",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx src/server/start.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check:contracts": "node scripts/validate-catalog.mjs",
    "vendor:contract": "npm --prefix ../packages/bridge-contract run build",
    "pretest": "npm run vendor:contract",
    "prebuild": "npm run vendor:contract",
    "pretypecheck": "npm run vendor:contract"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.5",
    "ajv": "8.20.0",
    "fastify": "5.12.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "@orchard/bridge-contract": "file:../packages/bridge-contract"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
