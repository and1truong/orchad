{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "chrome"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "noEmit": true
  },
  "include": [
    "src",
    "tests",
    "fixtures",
    "demo"
  ]
}