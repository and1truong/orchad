{
  "label": "TEST DOUBLE ONLY — scripted simulation, no LLM",
  "appId": "demo-counter",
  "documentId": "demo-document",
  "initial": { "revision": 0, "value": 0 },
  "cases": [
    {
      "approval": "approve",
      "call": {
        "requestId": "r1",
        "documentId": "demo-document",
        "toolName": "demo_increment",
        "arguments": { "amount": 1 },
        "expectedRevision": 0,
        "idempotencyKey": "key-1"
      },
      "expected": {
        "ok": true,
        "revision": 1,
        "data": { "value": 1, "revision": 1 },
        "error": null
      }
    },
    {
      "approval": "approve",
      "call": {
        "requestId": "retry",
        "documentId": "demo-document",
        "toolName": "demo_increment",
        "arguments": { "amount": 1 },
        "expectedRevision": 0,
        "idempotencyKey": "key-1"
      },
      "expected": {
        "ok": true,
        "revision": 1,
        "data": { "value": 1, "revision": 1 },
        "error": null
      }
    },
    {
      "approval": "approve",
      "call": {
        "requestId": "conflict",
        "documentId": "demo-document",
        "toolName": "demo_increment",
        "arguments": { "amount": 2 },
        "expectedRevision": 0,
        "idempotencyKey": "key-1"
      },
      "expectedError": "IDEMPOTENCY_CONFLICT"
    },
    {
      "approval": "approve",
      "call": {
        "requestId": "stale",
        "documentId": "demo-document",
        "toolName": "demo_increment",
        "arguments": { "amount": 1 },
        "expectedRevision": 0,
        "idempotencyKey": "key-2"
      },
      "expectedError": "STALE_CONTEXT"
    },
    {
      "approval": "deny",
      "call": {
        "requestId": "denied",
        "documentId": "demo-document",
        "toolName": "demo_increment",
        "arguments": { "amount": 1 },
        "expectedRevision": 1,
        "idempotencyKey": "key-3"
      },
      "expectedError": "APPROVAL_DENIED",
      "expectedValue": 1,
      "expectedDispatches": 4
    }
  ]
}
