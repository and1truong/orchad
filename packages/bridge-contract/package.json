{
  "name": "@orchard/bridge-contract",
  "version": "0.1.0",
  "type": "module",
  "description": "Single implementation of the Agent App Bridge 0.1 contract helpers, bounds constants, host-safe schema dialect and the portable interop scenario.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./scenario/*": "./scenario/*"
  },
  "files": [
    "dist",
    "scenario",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
